PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Embedded PostgreSQL is used locally when DATABASE_URL is empty.
DATABASE_URL=
DATA_FILE=.data/studio.pglite.tar.gz
# Production requires a separate non-owner database role and a 32+ character secret.
SESSION_SECRET=
GEMINI_API_KEY="AQ.Ab8RN6IKXfI8ZkmP3-ywhGku1_qvBjuydCs0o7spIXEslNP0VQ"
GEMINI_MODEL="gemma-4-26b-a4b-it"
# Never enable demo mode in production.
DEMO_MODE=true
SEED_DEMO=true
# Optional real SMS adapter; must accept {to, message} and return 2xx on acceptance.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
